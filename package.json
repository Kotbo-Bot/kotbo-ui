{
  "name": "@kotbo/ui",
  "version": "0.1.0",
  "description": "Bibliothèque UI et Analytics v3 partagée pour Kotbo et AegisAI",
  "keywords": [
    "svelte",
    "kotbo",
    "ui",
    "analytics"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/analytics": "./src/lib/analytics/index.js",
    "#lib/icons": "./src/lib/icons/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "svelte": "./dist/analytics/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "svelte": "./dist/icons/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.css"
    },
    "./styles.css": "./dist/styles/index.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/components.css": "./dist/styles/components.css"
  },
  "scripts": {
    "dev": "vite dev",
    "build:pkg": "svelte-kit sync && svelte-package && publint",
    "build": "bun run build:pkg && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "bun-types": "^1.4.5",
    "chart.js": "^4.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "chart.js": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    }
  },
  "dependencies": {
    "@getpapillon/papicons": "^0.2.3",
    "lucide-svelte": "^1.0.1",
    "react": "^19.3.1"
  }
}
